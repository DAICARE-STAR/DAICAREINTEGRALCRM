# Plantilla de variables de entorno. Copia a .env (local, fuera de git) o
# cárgalas en Netlify → Environment variables. Los valores van VACÍOS: si un
# valor de este archivo coincidiera con una variable real, el escáner de
# secretos de Netlify haría fallar el build.
#
# Clases (estandares/seguridad.md): PÚBLICA llega al navegador por diseño;
# SECRETA nunca sale de las funciones ni del PC del usuario; NO SENSIBLE es
# configuración. Cada módulo añade aquí sus variables al llegar;
# src/lib/__tests__/entorno.test.ts vigila que ninguna variable leída por el
# código falte y que cada una esté bajo su clase.

# --- PÚBLICA (Vite las expone al navegador; solo la clave anónima) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Web Push: la clave pública (la misma en las dos variables): VITE_ la lee el
# navegador para suscribirse y la otra las funciones
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
# Nombre visible de la instalación (título, manifest, cabecera). Vacío = «Portal del equipo».
VITE_PORTAL_NOMBRE=

# --- SECRETA (nunca al navegador, nunca en el chat ni en el repo) ---
SUPABASE_SERVICE_ROLE_KEY=
# Cadena de conexión directa del proyecto Supabase para tools/instalar/aplicar.mjs.
# Solo en el .env del PC de quien instala: el instalador la lee del entorno y
# nunca la imprime ni la acepta como argumento.
SUPABASE_DB_URL=
# IA de las funciones: clave de Google AI Studio con facturación y tope de gasto (PP-DEC-03)
GEMINI_API_KEY=
# Correo del equipo (SMTP de envío)
SMTP_PASS=
# Web Push: clave privada (rotarla invalida las suscripciones)
VAPID_PRIVATE_KEY=
# Scripts locales de verificación (tools/seguridad/sesion.mjs). Solo en el .env del PC.
CLAUDE_DEV_PASSWORD=

# --- NO SENSIBLE (configuración de las funciones) ---
SUPABASE_URL=
# Origen público del sitio: lo define Netlify sola; en local queda vacía
URL=
SMTP_HOST=
# 465 por defecto (TLS implícito); en otro puerto se exige STARTTLS
SMTP_PORT=
SMTP_USER=
# Remitente de Web Push (mailto: del responsable de la instalación)
VAPID_SUBJECT=
# Opcional: modelo global de Gemini; va después del IA_MODELO_<FUNCION> de cada función
GEMINI_MODEL=
IA_MODELO_BLOG_DRAFT=
IA_MODELO_LEAD_REPLY=
# Cuenta de servicio de los scripts locales (tools/seguridad/sesion.mjs)
CLAUDE_DEV_EMAIL=
# Origen de las funciones para tools/seguridad/pruebas-autorizacion.mjs (por defecto http://localhost:5190)
PORTAL_URL=
